# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (used for Stripe Checkout return URLs and admin links).
APP_URL="http://localhost:3000"

# ENCRYPTION_KEY: 32-byte (64-character hex) AES-256-GCM key for encrypting sensitive applicant fields & uploaded certificates at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ADMIN_PASSWORD: Password for the Bob Sumption / EasyApp Processing Admin Dashboard.
ADMIN_PASSWORD="ChangeThisStrongAdminPassword!"

# ADMIN_TOTP_SECRET: Base32 TOTP secret for 2-Factor Authentication on the Admin Dashboard.
# Generate or scan the QR code in the Admin Setup panel when first configuring 2FA.
ADMIN_TOTP_SECRET=""

# SESSION_SECRET: Random secret used to sign Admin session cookies and CSRF tokens.
SESSION_SECRET=""

# STRIPE_SECRET_KEY: Stripe Secret Key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Stripe Webhook Signing Secret (whsec_...)
STRIPE_WEBHOOK_SECRET=""

# SMTP / Email Provider configuration for sending notifications to bobsump@gmail.com and applicant receipts
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EasyApp Processing <noreply@easyappprocessing.com>"
ADMIN_NOTIFICATION_EMAIL="bobsump@gmail.com"
